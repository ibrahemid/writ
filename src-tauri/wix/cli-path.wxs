<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <DirectoryRef Id="INSTALLDIR">
            <Component Id="JotraCommandOnPath" Guid="CED06BBB-8BF4-46A7-9C2F-1B72C3806767">
                <Environment Id="JotraCommandPathEntry"
                             Name="PATH"
                             Value="[INSTALLDIR]"
                             Action="set"
                             Part="last"
                             System="yes"
                             Permanent="no" />
                <RegistryValue Root="HKCU"
                               Key="Software\Jotra\Command"
                               Name="OnPath"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>
    </Fragment>
</Wix>

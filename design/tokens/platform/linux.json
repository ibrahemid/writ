{
  "platform": {
    "linux": {
      "shared": {
        "font": {
          "$type": "fontFamily",
          "ui": { "$value": "\"Adwaita Sans\", Cantarell, Inter, sans-serif" },
          "prose": { "$value": "var(--writ-font-ui)" },
          "mono": { "$value": "\"Adwaita Mono\", \"Source Code Pro\", ui-monospace, monospace" }
        },
        "ui": {
          "$type": "dimension",
          "xs": { "$value": "12.03px" },
          "xs-lh": { "$value": "16.8px" },
          "sm": { "$value": "12.03px" },
          "sm-lh": { "$value": "16.8px" },
          "md": { "$value": "14.67px" },
          "md-lh": { "$value": "20.5px" },
          "lg": { "$value": "17.31px" },
          "lg-lh": { "$value": "24px" }
        },
        "prose": {
          "size": { "$type": "dimension", "$value": "16px" },
          "lh": { "$type": "number", "$value": "1.4" }
        },
        "h1": { "size": { "$type": "dimension", "$value": "1.66em" }, "weight": { "$type": "number", "$value": "800" }, "lh": { "$type": "number", "$value": "1.2" } },
        "h2": { "size": { "$type": "dimension", "$value": "1.247em" }, "weight": { "$type": "number", "$value": "700" }, "lh": { "$type": "number", "$value": "1.25" } },
        "h3": { "size": { "$type": "dimension", "$value": "1.082em" }, "weight": { "$type": "number", "$value": "700" }, "lh": { "$type": "number", "$value": "1.3" } },
        "h4": { "size": { "$type": "dimension", "$value": "1em" }, "weight": { "$type": "number", "$value": "700" }, "lh": { "$type": "number", "$value": "1.4" } },
        "r": {
          "$type": "dimension",
          "row": { "$value": "9px" },
          "control": { "$value": "9px" },
          "tab": { "$value": "9px" },
          "popover": { "$value": "15px" },
          "modal": { "$value": "15px" },
          "card": { "$value": "12px" },
          "media": { "$value": "9px" },
          "window": { "$value": "15px" }
        },
        "icon": {
          "size": { "$type": "dimension", "$value": "16px" },
          "opacity": { "$type": "number", "$value": "1" }
        },
        "sidebar": {
          "$type": "dimension",
          "row-pitch": { "$value": "38px" },
          "row-fill": { "$value": "36px" }
        }
      },
      "light": {
        "$type": "color",
        "bg": {
          "canvas": { "$value": "#FFFFFF" },
          "sidebar": { "$value": "#EEECE6" },
          "raised": { "$value": "#FFFDF9" },
          "sunken": { "$value": "#F4F2ED" },
          "hover": { "$value": "color-mix(in srgb, currentColor 7%, transparent)" },
          "selected": { "$value": "color-mix(in srgb, currentColor 10%, transparent)" }
        },
        "border": {
          "default": { "$value": "rgb(28 24 16 / 12%)", "$extensions": { "writ": { "cssName": "--writ-border" } } },
          "soft": { "$value": "rgb(28 24 16 / 7%)" }
        },
        "fg": {
          "default": { "$value": "rgb(28 24 16 / 88%)", "$extensions": { "writ": { "cssName": "--writ-fg" } } },
          "muted": { "$value": "rgb(28 24 16 / 48%)" },
          "faint": { "$value": "rgb(28 24 16 / 30%)" }
        },
        "shadow": {
          "$type": "shadow",
          "modal": {
            "$value": [
              { "offsetX": "0", "offsetY": "0", "blur": "14px", "spread": "5px", "color": "rgb(0 0 0 / 15%)" },
              { "offsetX": "0", "offsetY": "0", "blur": "5px", "spread": "2px", "color": "rgb(0 0 0 / 10%)" },
              { "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px", "color": "rgb(0 0 0 / 5%)" }
            ]
          },
          "popover": {
            "$value": [
              { "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px", "color": "rgb(0 0 0 / 5%)" },
              { "offsetX": "0", "offsetY": "1px", "blur": "5px", "spread": "1px", "color": "rgb(0 0 0 / 9%)" },
              { "offsetX": "0", "offsetY": "2px", "blur": "14px", "spread": "3px", "color": "rgb(0 0 0 / 5%)" }
            ]
          }
        },
        "lin": {
          "headerbar-bg": { "$value": "#FAF9F6" },
          "entry-bg": { "$value": "rgb(28 24 16 / 5%)" }
        }
      },
      "dark": {
        "$type": "color",
        "bg": {
          "canvas": { "$value": "#1C1A19" },
          "sidebar": { "$value": "#2E2B28" },
          "raised": { "$value": "#37332F" },
          "sunken": { "$value": "#232120" }
        },
        "border": {
          "default": { "$value": "rgb(0 0 6 / 36%)", "$extensions": { "writ": { "cssName": "--writ-border" } } },
          "soft": { "$value": "rgb(0 0 6 / 25%)" }
        },
        "fg": {
          "default": { "$value": "#F6F2EC", "$extensions": { "writ": { "cssName": "--writ-fg" } } },
          "muted": { "$value": "rgba(246,242,236,.55)" },
          "faint": { "$value": "rgba(246,242,236,.34)" }
        },
        "lin": {
          "headerbar-bg": { "$value": "#2E2B28" },
          "entry-bg": { "$value": "rgb(255 255 255 / 8%)" }
        }
      }
    }
  }
}

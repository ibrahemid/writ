          },
          "focus-outer": {
            "$value": "rgba(0,0,0,.894)"
          },
          "focus-inner": {
            "$value": "rgba(255,255,255,.702)"
          },
          "layer-stroke": {
            "$value": "rgba(0,0,0,.059)"
          },
          "close-bg": {
            "$value": "#C42B1C"
          },
          "close-fg": {
            "$value": "#FFFFFF"
          }
        }
      },
      "dark": {
        "$type": "color",
        "bg": {
          "canvas": {
            "$value": "#2E2B28"
          },
          "sidebar": {
            "$value": "#1B1917"
          },
          "raised": {
            "$value": "#2E2B28"
          },
          "sunken": {
            "$value": "#211F1D"
          },
          "hover": {
            "$value": "rgba(255,255,255,.059)"
          },
          "selected": {
            "$value": "rgba(255,255,255,.059)"
          }
        },
        "border": {
          "default": {
            "$value": "rgba(255,255,255,.094)",
            "$extensions": {
              "writ": {
                "cssName": "--writ-border"
              }
            }

        },
        "fg": {
          "default": {
            "$value": "#FFFFFF",
            "$extensions": {
              "writ": {
                "cssName": "--writ-fg"
              }
            }
          },
          "muted": {
            "$value": "rgba(255,255,255,.773)"
          },
          "faint": {
            "$value": "rgba(255,255,255,.529)"
          }
        },
        "shadow": {
          "$type": "shadow",
          "modal": {
            "$value": [
              {
                "offsetX": "0",
                "offsetY": "0",
                "blur": "8px",
                "color": "rgba(0,0,0,.40)"
              },
              {
                "offsetX": "0",
                "offsetY": "32px",
                "blur": "64px",
                "color": "rgba(0,0,0,.48)"
              }
            ]
          }
        },
        "win": {
          "stroke": {
            "$value": "rgba(255,255,255,.071)"
          },
          "stroke-strong": {
            "$value": "rgba(255,255,255,.545)"
          },
          "input": {
            "$value": "rgba(255,255,255,.059)"
          },
          "input-active": {
            "$value": "rgba(30,30,30,.702)"
          },
          "focus-outer": {
            "$value": "#FFFFFF"
          },
          "focus-inner": {
            "$value": "rgba(0,0,0,.702)"
          },
          "layer-stroke": {

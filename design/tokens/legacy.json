{
  "legacy": {
    "$type": "other",
    "$description": "Every pre-ADR-030 custom property. Colour names map onto their new source (the theme store overwrites them from the active preset anyway); every other name is frozen at the value origin/main declared, so an unmigrated stylesheet renders exactly as it did. Each unit drops the aliases its files stop using; the last one deletes this file.",
    "surface-background": {
      "$value": "var(--writ-bg-canvas)"
    },
    "surface-sunken": {
      "$value": "var(--writ-bg-sidebar)"
    },
    "surface-raised": {
      "$value": "var(--writ-bg-raised)"
    },
    "surface-elevated": {
      "$value": "var(--writ-bg-selected)"
    },
    "surface-input": {
      "$value": "var(--writ-bg-sunken)"
    },
    "surface-hover": {
      "$value": "var(--writ-bg-hover)"
    },
    "foreground-default": {
      "$value": "var(--writ-fg)"
    },
    "foreground-muted": {
      "$value": "var(--writ-fg-muted)"
    },
    "foreground-subtle": {
      "$value": "var(--writ-fg-faint)"
    },
    "border-default": {
      "$value": "var(--writ-border)"
    },
    "border-focus": {
      "$value": "var(--writ-accent)"
    },
    "border-pill": {
      "$value": "var(--writ-border)"
    },
    "accent-default": {
      "$value": "var(--writ-accent)"
    },
    "accent-foreground": {
      "$value": "var(--writ-accent-fg)"
    },
    "font-sans": {
      "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"SF Arabic\", \"Geeza Pro\", \"Noto Naskh Arabic\", system-ui, sans-serif",
      "$description": "Inter is still bundled until the prose-face work lands, so the alias keeps the stack it had."
    },
    "font-size": {
      "$value": "14px"
    },
    "font-size-sm": {
      "$value": "12px"
    },
    "font-size-xs": {
      "$value": "11px"
    },
    "line-height": {
      "$value": "1.6"
    },
    "editor-font-size": {
      "$value": "14px",
      "$description": "Pre-paint default only. editorZoom writes the live value onto the root from editor.font_size."
    },
    "radius-1": {
      "$value": "4px"
    },
    "radius-2": {
      "$value": "6px"
    },
    "radius-3": {
      "$value": "10px"
    },
    "window-radius": {
      "$value": "10px"
    },
    "sidebar-width": {
      "$value": "260px"
    },
    "statusbar-height": {
      "$value": "28px"
    },
    "tabbar-height": {
      "$value": "36px"
    },
    "titlebar-height": {
      "$value": "36px"
    },
    "tab-pill-height": {
      "$value": "28px"
    },
    "bg-tab-pill": {
      "$value": "transparent"
    },
    "overlay-hover": {
      "$value": "color-mix(in srgb, var(--writ-foreground-default) 8%, transparent)"
    },
    "overlay-subtle": {
      "$value": "color-mix(in srgb, var(--writ-foreground-default) 4%, transparent)"
    },
    "overlay-scrim": {
      "$value": "rgba(0, 0, 0, 0.5)"
    },
    "selection": {
      "$value": "color-mix(in srgb, var(--writ-accent-default) 30%, transparent)"
    },
    "warning-foreground": {
      "$value": "color-mix(in srgb, var(--writ-status-warning) 68%, var(--writ-foreground-default))"
    },
    "shadow-modal": {
      "$value": "0 12px 32px rgba(0, 0, 0, 0.32), 0 2px 6px rgba(0, 0, 0, 0.24)",
      "$description": "Re-declared, not aliased: the name survives into the new vocabulary, so the unit that migrates its consumers drops this entry and lets the generated elevation through."
    },
    "shadow-overlay": {
      "$value": "0 14px 40px rgba(0, 0, 0, 0.5), 0 2px 8px rgba(0, 0, 0, 0.4)"
    },
    "shadow-dialog": {
      "$value": "0 10px 26px rgba(0, 0, 0, 0.28)"
    },
    "shadow-popover": {
      "$value": "0 8px 24px rgba(0, 0, 0, 0.4)",
      "$description": "Re-declared, not aliased. See shadow-modal."
    },
    "shadow-banner": {
      "$value": "0 6px 24px rgba(0, 0, 0, 0.32)"
    },
    "shadow-toast": {
      "$value": "0 4px 16px rgba(0, 0, 0, 0.3)"
    },
    "shadow-sidebar": {
      "$value": "4px 0 12px -8px rgba(0, 0, 0, 0.6)"
    },
    "shadow-chip": {
      "$value": "0 2px 8px rgba(0, 0, 0, 0.25)",
      "$description": "Re-declared, not aliased. See shadow-modal."
    },
    "shadow-xs": {
      "$value": "0 1px 2px rgba(0, 0, 0, 0.2)"
    }
  }
}

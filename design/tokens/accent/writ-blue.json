              "cssName": "--writ-accent"
            }
          }
        },
        "hover": {
          "$value": "#87ABF8",
          "$extensions": {
            "writ": {
              "cssName": "--writ-accent-hover"
            }
          }
        },
        "foreground": {
          "$value": "#151C2A",
          "$extensions": {
            "writ": {
              "cssName": "--writ-accent-fg"
            }
          }
        }
      },
      "$description": "The accent Writ shipped through 0.3.x."
    }
  }

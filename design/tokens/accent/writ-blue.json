{
  "accent": {
    "writ-blue": {
      "$type": "color",
      "light": {
        "base": {
          "$value": "#3B5BDB",
          "$extensions": {
            "writ": {
              "cssName": "--writ-accent"
            }
          }
        },
        "hover": {
          "$value": "#3552C5",
          "$extensions": {
            "writ": {
              "cssName": "--writ-accent-hover"
            }
          }
        },

---
import '../styles/tokens.css';
import '../styles/site.css';
import interUrl from '../../design-system/fonts/inter-latin-variable.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import release from '../data/release.json';
import { COLORS } from '../../../src/styles/generated/tokens';

interface Props {
  /** The page's H1. The document title is this plus " | Writ". */
  title: string;
  description: string;
  path: string;
  /** Pages that have no address of their own: 404 is served under any path. */
  unlisted?: boolean;
}

const { title, description, path, unlisted = false } = Astro.props;

const SITE_URL = 'https://writ.ibrahemid.com';

// The analytics tag ships only when the build is handed a script URL. A tag
// pointed at a host that is down is a network error in every visitor's console
// and nothing on the page can suppress it, so an unreachable endpoint is a
// build-time decision rather than a runtime one. Set the repository variable
// UMAMI_SRC to turn it back on; the workflow passes it through as
// PUBLIC_UMAMI_SRC.
const ANALYTICS_SITE_ID = '0707b80b-a533-44a9-9bdf-c1eee7576372';
const analyticsSrc = import.meta.env.PUBLIC_UMAMI_SRC ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = SITE_URL + base + path;
const ogImage = SITE_URL + base + '/brand/og-1-0.png';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Writ',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 12+, Windows 10+, Linux',
  softwareVersion: release.version,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: SITE_URL + base + '/download/',
  license: 'https://github.com/ibrahemid/writ/blob/main/LICENSE',
  url: SITE_URL + base + '/',
  screenshot: ogImage,
};
// The face is declared here rather than in a stylesheet so the preload and
// the @font-face carry the same hashed URL the build gives the file.
const fontFace = `@font-face{font-family:"Inter";font-style:normal;font-weight:400 600;font-display:swap;src:url("${interUrl}") format("woff2-variations")}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={COLORS.light.bgCanvas} />
    <title>{title} | Writ</title>
    <meta name="description" content={description} />
    {unlisted ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace}></style>

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/brand/icon-32.png`} />
    <link rel="icon" type="image/png" sizes="128x128" href={`${base}/brand/icon-128.png`} />
    <link rel="apple-touch-icon" sizes="256x256" href={`${base}/brand/icon-256.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} | Writ`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Writ`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />

    {analyticsSrc && (
      <script is:inline defer src={analyticsSrc} data-website-id={ANALYTICS_SITE_ID} data-domains="writ.ibrahemid.com" data-do-not-track="true"></script>
    )}
  </head>
  <body>
    <a href="#content" class="skip">Skip to content</a>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>

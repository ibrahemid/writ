---
import '../../design-system/colors_and_type.css';
import '../styles/base.css';
import TopHeader from '../components/site/TopHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import release from '../data/release.json';

interface Props {
  title: string;
  description?: string;
  path?: string;
  heroDark?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Pages that have no address of their own: 404 is served under any path. */
  unlisted?: boolean;
}

const {
  title,
  description = 'A scratchpad that is already open. One hotkey over any app, saved as you type, every note searchable. Free, offline, macOS, Windows, Linux.',
  path = '/',
  heroDark = false,
  jsonLd,
  unlisted = false,
} = Astro.props;

const SITE_URL = 'https://writ.ibrahemid.com';

// The analytics tag ships only when the build is handed a script URL. A tag
// pointed at a host that is down is a network error in every visitor's console
// and nothing on the page can suppress it, so an unreachable endpoint is a
// build-time decision rather than a runtime one. Set the repository variable
// UMAMI_SRC to turn it back on; the workflow passes it through as
// PUBLIC_UMAMI_SRC.
const ANALYTICS_SITE_ID = '0707b80b-a533-44a9-9bdf-c1eee7576372';
const analyticsSrc = import.meta.env.PUBLIC_UMAMI_SRC ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = SITE_URL + base + path;
const ogImage = SITE_URL + base + '/brand/og-v2.png';
const ld = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Writ',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 12+, Windows 10+, Linux',
  softwareVersion: release.version,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: SITE_URL + base + '/download/',
  license: 'https://github.com/ibrahemid/writ/blob/main/LICENSE',
  url: SITE_URL + base + '/',
  screenshot: ogImage,
};
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b11" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {unlisted ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/brand/icon-32.png`} />
    <link rel="icon" type="image/png" sizes="128x128" href={`${base}/brand/icon-128.png`} />
    <link rel="apple-touch-icon" sizes="256x256" href={`${base}/brand/icon-256.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />

    {analyticsSrc && (
      <script is:inline defer src={analyticsSrc} data-website-id={ANALYTICS_SITE_ID} data-domains="writ.ibrahemid.com" data-do-not-track="true"></script>
    )}

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('writ:theme');
          var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="v2-page">
      <TopHeader onDark={heroDark} />
      <div id="content" tabindex="-1">
        <slot />
      </div>
      <SiteFooter />
    </div>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 10px 16px;
    background: var(--accent);
    color: var(--accent-foreground);
    border-radius: 0 0 8px 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .skip-link:focus { left: 0; }
</style>

---
import Prose from '../layouts/Prose.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Prose title="Nothing at this address" description="The page you asked for does not exist." path="/404/" lead="The link is wrong or the page moved. Nothing of yours was lost." unlisted>
  <ul>
    <li><a href={`${base}/`}>Home</a></li>
    <li><a href={`${base}/download/`}>Download</a></li>
    <li><a href={`${base}/docs/`}>Docs</a></li>
    <li><a href={`${base}/guides/`}>Guides</a></li>
    <li><a href={`${base}/changelog/`}>Changelog</a></li>
  </ul>
</Prose>

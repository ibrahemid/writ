---
import Site from '../layouts/Site.astro';
import LiveWindow from '../components/LiveWindow.astro';
import Feature from '../components/Feature.astro';
import DownloadRows from '../components/DownloadRows.astro';
import release from '../data/release.json';
import tokensCss from '../styles/tokens.css?raw';

class MissingTokenError extends Error {
  constructor(token: string) {
    super(`site/src/styles/tokens.css declares no ${token}; run pnpm tokens:build at the repository root.`);
    this.name = 'MissingTokenError';
  }
}

const writTourBp = /--writ-site-bp-lg:\s*([^;]+);/.exec(tokensCss)?.[1]?.trim();
if (!writTourBp) throw new MissingTokenError('--writ-site-bp-lg');

const NOUNS = ['text', 'note', 'scratchpad', 'Markdown editor', 'journal', 'to-do list'];
const repo = 'https://github.com/ibrahemid/writ';
const mb = (n: number | undefined): string => (n ? `${Math.round(n / 1048576)}\u00a0MB` : '');
const detail = [`v${release.version}`, 'macOS 12+', 'Windows 10+', 'Linux', mb(release.platforms.mac.size_pkg)]
  .filter(Boolean)
  .join(' · ');
const p = release.platforms;
---
<Site
  title="The only text app you need"
  description="Writ opens any text file and searches every file in its folder. A Markdown file renders inline as you type. Free, for macOS, Windows and Linux."
  path="/"
>
  <Fragment slot="head">
    <script is:inline define:vars={{ writTourBp }}>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-writ-intro', '');
        if (window.matchMedia('(min-width: ' + writTourBp + ')').matches) {
          document.documentElement.setAttribute('data-writ-tour', '');
        }
      }
    </script>
  </Fragment>
  <main id="content">
    <section class="hero wrap">
      <h1 class="hero-h1">
        The only <br class="br-sm" /><span class="noun-slot" data-noun-slot>{NOUNS.map((n, i) => (
          <span class:list={['noun', { 'is-on': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>{n}</span>
        ))}</span><br /> app you need
      </h1>
      <p class="hero-sub">Writ opens any text file and searches every file in its folder. A Markdown file renders inline as you type.</p>
      <div class="hero-ctas">
        <a
          href={p.mac.pkg}
          class="btn btn-primary"
          data-dl
          data-mac={p.mac.pkg}
          data-mac-name="macOS"
          data-win={p.win.msi}
          data-win-name="Windows"
          data-linux={p.linux.appImage}
          data-linux-name="Linux"
        >Download for macOS</a>
        <a href={repo} class="btn btn-text" rel="noopener">GitHub</a>
      </div>
      <p class="hero-detail">{detail}</p>
    </section>
    <div class="stage">
      <div class="hero-media wrap-media">
        <LiveWindow alt="The Writ window: the folder in the sidebar and a Markdown file rendered inline, the line being edited showing its markup" />
      </div>

      <Feature id="any-file" loop="any-file" title="Any file" capture="text-file" alt="A plain text to-do list open in Writ">
        <p>A <code>.txt</code>, a log, a config or a Markdown file opens from your file manager or the <code>writ</code> command and saves back to its own path.</p>
      </Feature>

      <Feature id="markdown" loop="markdown" anchor="bottom" title="Markdown, inline" capture="markdown-inline" alt="A Markdown file in Writ with headings, checkboxes and a code block rendered in place" flip>
        <p>Headings, lists, links and checkboxes render in place, and the line you are editing shows its markup.</p>
      </Feature>

      <Feature id="search" loop="search" title="Search" capture="search" alt="Writ's search listing every file in the folder that mentions compost, with the matching line">
        <p>One query matches file names and the text inside them.</p>
      </Feature>

      <Feature id="apps" loop="apps" title="Apps" capture="apps" alt="Writ's Settings on the Apps section, with Graph switched on" flip>
        <p>Connections, the graph, tags, chat, rewriting and connected programs are switches in Settings, and each adds nothing to the window until it is on.</p>
      </Feature>

      <Feature id="graph" loop="graph" title="Graph" capture="graph-folder" alt="Writ's graph of a folder, each file a dot in its folder's color and each link a line between two files">
        <p>The graph draws each file in the folder as a dot and each link between two files as a line, with a color per top-level folder. Typing a name lights the files that match, and clicking one opens it.</p>
      </Feature>

      <Feature id="versions" loop="versions" title="Earlier versions" capture="versions" alt="The earlier versions of a file listed by time, one open beside the list with Restore this version under it" flip>
        <p>Writ keeps a version of a file in its folder each time it is saved, for up to 30 days, stored outside that folder. Revert To, in the File menu, lists them and restores the one you pick.</p>
      </Feature>
    </div>

    <section class="download wrap" id="download">
      <h2>Download</h2>
      <DownloadRows />
    </section>
  </main>
</Site>

<script is:inline>
  (function () {
    var slot = document.querySelector('[data-noun-slot]');
    if (!slot) return;
    var nouns = Array.prototype.slice.call(slot.querySelectorAll('.noun'));
    if (nouns.length < 2) return;
    class NounIntervalError extends Error {
      constructor(raw) {
        super('The noun rotation reads --writ-site-motion-noun-interval as a time, and the page resolved it to "' + raw + '".');
        this.name = 'NounIntervalError';
      }
    }
    var reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    var i = 0;
    var timer = null;
    // Read on each start: the token is 0ms under reduced motion, and the
    // bundler may rewrite 2400ms as 2.4s, so the unit is read, not assumed.
    function readInterval() {
      var raw = getComputedStyle(slot).getPropertyValue('--writ-site-motion-noun-interval').trim();
      var time = /^(\d*\.?\d+)(ms|s)$/.exec(raw);
      var interval = time ? Number(time[1]) * (time[2] === 'ms' ? 1 : 1000) : 0;
      if (!(interval > 0)) throw new NounIntervalError(raw);
      return interval;
    }
    function fitSlot() {
      if (timer !== null) slot.style.width = nouns[i].offsetWidth + 'px';
    }
    function showNextNoun() {
      nouns.forEach(function (noun) {
        noun.classList.remove('is-out');
      });
      nouns[i].classList.remove('is-on');
      nouns[i].classList.add('is-out');
      i = (i + 1) % nouns.length;
      nouns[i].classList.add('is-on');
      fitSlot();
    }
    function startRotation() {
      if (timer !== null) return;
      var interval = readInterval();
      slot.classList.add('is-live');
      timer = window.setInterval(showNextNoun, interval);
      fitSlot();
    }
    function stopRotation() {
      if (timer === null) return;
      window.clearInterval(timer);
      timer = null;
      nouns.forEach(function (noun) {
        noun.classList.remove('is-on', 'is-out');
      });
      i = 0;
      nouns[0].classList.add('is-on');
      slot.classList.remove('is-live');
      slot.style.width = '';
    }
    if (document.fonts) document.fonts.ready.then(fitSlot);
    window.addEventListener('resize', fitSlot);
    reducedQuery.addEventListener('change', function () {
      if (reducedQuery.matches) stopRotation();
      else startRotation();
    });
    if (!reducedQuery.matches) startRotation();
  })();
</script>

<script is:inline>
  // The primary button names the visitor's OS and links to its build; the
  // markup defaults to macOS for readers without JS.
  (function () {
    var a = document.querySelector('[data-dl]');
    if (!a) return;
    var p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
    var ua = navigator.userAgent || '';
    var os = /win/i.test(p) ? 'win' : /linux/i.test(p) && !/android/i.test(ua) ? 'linux' : /mac/i.test(p) ? 'mac' : '';
    if (!os || !a.dataset[os] || a.dataset[os] === '#') return;
    a.href = a.dataset[os];
    a.textContent = 'Download for ' + a.dataset[os + 'Name'];
  })();
</script>

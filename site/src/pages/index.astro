---
import Site from '../layouts/Site.astro';
import Capture from '../components/Capture.astro';
import Feature from '../components/Feature.astro';
import DownloadRows from '../components/DownloadRows.astro';
import release from '../data/release.json';

const repo = 'https://github.com/ibrahemid/writ';
const NOUNS = ['note', 'scratchpad', 'Markdown editor', 'journal', 'to-do list'];
const mb = (n: number | undefined): string => (n ? `${Math.round(n / 1048576)}\u00a0MB` : '');
const detail = [`v${release.version}`, 'macOS 12+', 'Windows 10+', 'Linux', mb(release.platforms.mac.size_pkg)]
  .filter(Boolean)
  .join(' · ');
const p = release.platforms;
---
<Site
  title="The only note app you need"
  description="Notes as Markdown files in a folder you can open, with links, a graph and an MCP server built in. Free, offline, for macOS, Windows and Linux."
  path="/"
>
  <main id="content">
    <section class="hero wrap">
      <h1 class="hero-h1">
        The only <br class="br-sm" /><span class="noun-slot" data-noun-slot>{NOUNS.map((n, i) => (
          <span class:list={['noun', { 'is-on': i === 0 }]}>{n}</span>
        ))}</span><br /> app you need
      </h1>
      <p class="hero-sub">Markdown files in a folder you can open, with links, a graph and an MCP server built in.</p>
      <div class="hero-ctas">
        <a
          href={p.mac.pkg}
          class="btn btn-primary"
          data-dl
          data-mac={p.mac.pkg}
          data-mac-name="macOS"
          data-win={p.win.msi}
          data-win-name="Windows"
          data-linux={p.linux.appImage}
          data-linux-name="Linux"
        >Download for macOS</a>
        <a href={repo} class="btn btn-text" rel="noopener">GitHub</a>
      </div>
      <p class="hero-detail">{detail}</p>
    </section>
    <div class="hero-media wrap-media">
      <Capture name="hero-window" alt="The Writ window: the notes folder in the sidebar, a note open with its rendered preview beside it" loading="eager" fetchpriority="high" />
    </div>

    <Feature id="files" title="Every note is a file" capture="notes-folder" alt="The notes folder in Finder, one Markdown file per note">
      <p>Notes are plain Markdown files in a folder you can open, <code>~/Writ</code> unless you move it. The folder is the only copy: the database holds an index and window state and can be deleted without losing a note.</p>
    </Feature>

    <Feature id="links" title="Links and Connections" capture="connections" alt="A note with the Connections panel beside it: the notes that link here, the outline and the properties" flip>
      <p>Write <code>[[Name]]</code> to link a note by name. The Connections panel lists the notes that link back, the outline and the properties, and renaming a note offers to rewrite the links that point at it.</p>
    </Feature>

    <Feature id="graph" title="Graph" capture="graph-folder" alt="Graph view of a whole notes folder, one color per folder">
      <p>Nearby notes draws the ones linked around the note you have open. Graph view draws the whole folder, and tags sit in the sidebar.</p>
    </Feature>

    <Feature id="programs" title="Programs" capture="chat" alt="The chat pane beside a note, the attached notes listed at the top and a proposed edit shown next to the text" flip>
      <p>Writ ships an MCP server, off by default: approve each program by name, reading and writing separately, and every call is listed in the Activity panel without the note's text. The chat pane, also off by default, sends only the notes you attach and returns edits as proposals you apply or discard.</p>
    </Feature>

    <Feature id="versions" title="Earlier versions" capture="versions" alt="The earlier versions of a note listed beside it, with Revert To on one of them">
      <p>Writ keeps a version each time a note is saved, for thirty days, in its own data folder and never inside the notes folder. Revert To puts one back.</p>
    </Feature>

    <section class="download wrap" id="download">
      <h2>Download</h2>
      <DownloadRows />
    </section>
  </main>
</Site>

<script is:inline>
  // The noun in the H1 crossfades through the list every 2.4 s. Without JS,
  // or under prefers-reduced-motion, the first noun is the whole line.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var slot = document.querySelector('[data-noun-slot]');
    if (!slot) return;
    var nouns = Array.prototype.slice.call(slot.querySelectorAll('.noun'));
    if (nouns.length < 2) return;
    // The bundler may rewrite 2400ms as 2.4s, so the unit is read, not assumed.
    var raw = getComputedStyle(slot).getPropertyValue('--writ-site-motion-noun-interval').trim();
    var interval = (parseFloat(raw) || 2.4) * (/ms$/.test(raw) ? 1 : 1000);
    var i = 0;
    slot.classList.add('is-live');
    function fit() {
      slot.style.width = nouns[i].offsetWidth + 'px';
    }
    fit();
    window.addEventListener('resize', fit);
    window.setInterval(function () {
      nouns[i].classList.remove('is-on');
      i = (i + 1) % nouns.length;
      nouns[i].classList.add('is-on');
      fit();
    }, interval);
  })();
</script>

<script is:inline>
  // The primary button names the visitor's OS and links to its build; the
  // markup defaults to macOS for readers without JS.
  (function () {
    var a = document.querySelector('[data-dl]');
    if (!a) return;
    var p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
    var ua = navigator.userAgent || '';
    var os = /win/i.test(p) ? 'win' : /linux/i.test(p) && !/android/i.test(ua) ? 'linux' : /mac/i.test(p) ? 'mac' : '';
    if (!os || !a.dataset[os] || a.dataset[os] === '#') return;
    a.href = a.dataset[os];
    a.textContent = 'Download for ' + a.dataset[os + 'Name'];
  })();
</script>

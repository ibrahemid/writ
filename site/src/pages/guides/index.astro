---
import Prose from '../../layouts/Prose.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guides = [
  { href: 'obsidian-vault-files', title: 'Open a folder written in Obsidian', p: 'Point Writ at the folder. Links, properties, tags and callouts read as written, and both apps keep using the same files.' },
  { href: 'agent-output', title: 'Give an assistant your notes with MCP', p: 'Connect Claude Code or another MCP client to the notes folder, approve what it may do, and see what it did.' },
  { href: 'default-md-app', title: 'Make Writ the app for .md files', p: 'Register Writ for text and markdown so a double-click in Finder or Explorer opens here.' },
];
---
<Prose title="Guides" description="Step-by-step guides: opening a folder written in Obsidian, connecting an MCP client to your notes, making Writ the default app for markdown." path="/guides/" lead="Three things people set up in the first week.">
  {guides.map((g) => (
    <Fragment>
      <h2><a href={`${base}/guides/${g.href}/`}>{g.title}</a></h2>
      <p>{g.p}</p>
    </Fragment>
  ))}
</Prose>

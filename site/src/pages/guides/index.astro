---
import Site from '../../layouts/Site.astro';
import Doc from '../../components/site/Doc.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guides = [
  { href: 'obsidian-vault-files', title: 'Open a folder written in Obsidian', p: 'Point Writ at the folder. Links, properties, tags and callouts read as written, and both apps keep using the same files.' },
  { href: 'agent-output', title: 'Give an assistant your notes with MCP', p: 'Connect Claude Code or another MCP client to the notes folder, approve what it may do, and see what it did.' },
  { href: 'default-md-app', title: 'Make Writ the app for .md files', p: 'Register Writ for text and markdown so a double-click in Finder or Explorer opens here.' },
];
---
<Site title="Writ guides" description="Step-by-step guides: opening a folder written in Obsidian, connecting an MCP client to your notes, making Writ the default app for markdown." path="/guides/">
  <Doc eyebrow="guides" title="Guides." shot="still-sidebar-history" shotAlt="The Writ sidebar listing open notes and recently closed ones" lead="Three things people set up in the first week.">
    <div class="doc-grid">
      {guides.map((g) => (
        <a class="from" href={`${base}/guides/${g.href}/`}>
          <div class="from-h">{g.title}</div>
          <p class="from-p">{g.p}</p>
          <div class="from-l">Read →</div>
        </a>
      ))}
    </div>
  </Doc>
</Site>

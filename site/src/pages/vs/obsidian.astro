---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/guides/obsidian/`;
const canonical = `https://writ.ibrahemid.com${target}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Writ and Obsidian on one folder | Writ</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <a href={target}>Writ and Obsidian on one folder</a>
  </body>
</html>

---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Prose from '../layouts/Prose.astro';
import { releases } from '../data/changelog';
import { findChangelogImage } from '../lib/changelog-image';
import { CHANGELOG_PLATFORM_LABELS, stripPlatformLead } from '../lib/changelog-text';

const images = import.meta.glob<ImageMetadata>('/src/assets/changelog/*.png', { eager: true, import: 'default' });
const widthsFor = (src: ImageMetadata): number[] => [640, 960, 1320, 1920].filter((w) => w < src.width).concat(src.width);
---
<Prose title="Changelog" description="What ships in each release of Writ." path="/changelog/">
  {releases.map((rel) => (
    <article class="rel" id={`v${rel.version}`}>
      <h2>v{rel.version}{rel.label && `: ${rel.label}`}</h2>
      <time class="rel-date" datetime={rel.date}>{rel.date}</time>
      <ul>
        {rel.notes.map((n) => {
          const shot = n.image && { alt: n.image.alt, src: findChangelogImage(images, n.image.file) };
          return (
            <li>
              <span class="rel-kind">{n.kind}</span>
              <div>
                {n.platforms?.map((p) => <span class="rel-tag">{CHANGELOG_PLATFORM_LABELS[p]}</span>)}
                <span>{stripPlatformLead(n.text, n.platforms)}</span>
                {shot && (
                  <figure class="window">
                    <Picture src={shot.src} alt={shot.alt} formats={['avif', 'webp']} widths={widthsFor(shot.src)} sizes="(max-width: 880px) 100vw, 720px" loading="lazy" />
                  </figure>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </article>
  ))}
</Prose>

---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ibrahemid/writ';
---
<header class="nav">
  <div class="wrap nav-in">
    <a href={`${base}/`} class="nav-mark">
      <img src={`${base}/brand/icon-128.png`} alt="" width="24" height="24" />
      Writ
    </a>
    <nav class="nav-links" aria-label="Site">
      <a href={`${base}/docs/`}>Docs</a>
      <a href={`${base}/changelog/`}>Changelog</a>
      <a href={repo} rel="noopener">GitHub</a>
      <a href={`${base}/download/`} class="btn btn-primary">Download</a>
    </nav>
  </div>
</header>

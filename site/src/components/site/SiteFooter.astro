---
import release from '../../data/release.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ibrahemid/writ';
const published = release.published === true;
---
<footer class="site-footer page" data-theme="dark">
  <div class="ft-grid u-wide">
    <div>
      <a href={`${base}/`} class="ft-logo">Writ<span>.</span></a>
      {published && <span class="ft-ver">v{release.version}</span>}
    </div>
    <div class="ft-col">
      <h4>Product</h4>
      <a href={`${base}/download/`}>Download</a>
      <a href={`${base}/changelog/`}>Changelog</a>
      <a href={`${base}/docs/`}>Docs</a>
      <a href={`${base}/guides/`}>Guides</a>
    </div>
    <div class="ft-col">
      <h4>Compare</h4>
      <a href={`${base}/vs/obsidian/`}>Obsidian</a>
      <a href={`${base}/vs/typora/`}>Typora</a>
      <a href={`${base}/vs/apple-notes/`}>Apple Notes</a>
    </div>
    <div class="ft-col">
      <h4>Source</h4>
      <a href={repo} rel="noopener noreferrer" target="_blank">GitHub</a>
      <a href={`${repo}/releases`} rel="noopener noreferrer" target="_blank">Releases</a>
      <a href={`${repo}/issues`} rel="noopener noreferrer" target="_blank">Issues</a>
      <a href={`${repo}/blob/main/LICENSE`} rel="noopener noreferrer" target="_blank">MIT license</a>
    </div>
    <div class="ft-col">
      <h4>About</h4>
      <a href={`${base}/press/`}>Press kit</a>
      <a href={`${base}/privacy/`}>Privacy</a>
    </div>
  </div>
</footer>

---
import Section from './Section.astro';
---
<Section slug="render" id="render">
  <h2 class="sec-h2">Opens anything. Draws four formats live.</h2>
  <p class="sec-p">
    Code with syntax highlighting, configs and logs as plain text, binaries as hex, large
    files without choking. Lists continue on Enter, checkboxes toggle on click. Load one
    into the window:
  </p>
  <div class="trig-row">
    <button class="gtrig" type="button" data-cmd="loadFmt" data-arg="md"><span class="trig-g">#</span> Markdown</button>
    <button class="gtrig" type="button" data-cmd="loadFmt" data-arg="html"><span class="trig-g">&lt;/&gt;</span> HTML</button>
    <button class="gtrig" type="button" data-cmd="loadFmt" data-arg="mermaid"><span class="trig-g">A→B</span> Mermaid</button>
    <button class="gtrig" type="button" data-cmd="loadFmt" data-arg="math"><span class="trig-g">∑</span> KaTeX</button>
    <button class="gtrig" type="button" data-cmd="open" data-arg="icon-256.png"><span class="trig-g">0x</span> Binary as hex</button>
    <button class="gtrig" type="button" data-cmd="open" data-arg="gateway-week.log"><span class="trig-g">≣</span> A large log</button>
  </div>
</Section>

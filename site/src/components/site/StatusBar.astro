---
const sections = [
  { token: '# writ', href: '#top', sect: 'top' },
  { token: '## loop', href: '#loop', sect: 'loop' },
  { token: '## window', href: '#editor', sect: 'editor' },
  { token: '## open', href: '#open', sect: 'open' },
  { token: '## find', href: '#search', sect: 'search' },
  { token: '## keeps', href: '#keeps', sect: 'keeps' },
  { token: '## from', href: '#from', sect: 'from' },
  { token: '## index', href: '#index', sect: 'index' },
  { token: '## install', href: '#download', sect: 'download' },
];
---
<nav class="pagebar" aria-label="Sections">
  <span class="pb-file" aria-hidden="true">writ / index.md</span>
  <div class="pb-toks">
    {sections.map((s) => (
      <a href={s.href} class="pb-tok" data-sect={s.sect}>{s.token}</a>
    ))}
  </div>
  <span class="pb-save" aria-hidden="true"><i class="pb-save-dot"></i>saved</span>
</nav>

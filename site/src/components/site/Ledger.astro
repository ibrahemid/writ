---
interface KcCol {
  h: string;
  rows: { label: string; groups: string[][] }[];
}
interface PresetChip {
  name: string;
  polarity: string;
  bg: { canvas: string };
  fg: { default: string };
  accent: { default: string };
  syntax: { keyword: string; string: string; comment: string };
}
interface Props {
  kcCols: readonly KcCol[];
  presets: readonly PresetChip[];
}
const { kcCols, presets } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rows: { name: string; fact: string; keys?: string[]; mono?: string }[] = [
  { name: 'Open links', fact: 'Web links open in your browser, file links open in Writ. You see the destination before anything opens.', keys: ['⌘', 'Click'] },
  { name: 'Command palette', fact: 'Every command and setting, searchable.', keys: ['⇧', '⇧'] },
  { name: 'Go to line', fact: 'A colon and a number, from the search palette.', mono: ':42' },
  { name: 'Folders', fact: 'Point Writ at a folder and it lists in the sidebar; search covers its files too.' },
  { name: 'Watched inbox', fact: 'Files dropped into one folder list themselves and open as they arrive.' },
  { name: 'Default app', fact: 'Make Writ the app for .md, .txt, .log and other text. Double-click opens here.' },
  { name: 'From a terminal', fact: 'Send a file or a command\'s output to the open window.', mono: 'writ notes.md' },
  { name: 'Tabs', fact: 'Reopen a closed one, rename on double-click.', keys: ['⌘', '⇧', 'T'] },
  { name: 'Tidy text', fact: 'Trim trailing spaces, straighten quotes, collapse runs of spaces. Each one a command.' },
  { name: 'Spelling', fact: 'Runs on your machine, off until you turn it on. Double-click a flagged word to fix it.' },
  { name: 'Rewrite', fact: 'Proofread or rephrase a selection with a local model or your own key. Off by default.' },
  { name: 'Zoom', fact: 'One level scales the editor and the rendered note together.', keys: ['⌘', '='] },
  { name: 'Right to left', fact: 'Arabic, Hebrew and Persian lines set their own direction.' },
];
---
<section class="band sec" id="index">
  <span class="mark" aria-hidden="true"><span class="gm-h">##</span> index</span>
  <div class="u-wide mo">
    <h2 class="sec-h2">The index.</h2>
    <div class="ledger">
      {rows.map((r) => (
        <div class="lg-row">
          <span class="lg-name">{r.name}</span>
          <span class="lg-fact">{r.fact}</span>
          {r.keys && (
            <span class="lg-keys">{r.keys.map((k) => <kbd class="kc">{k}</kbd>)}</span>
          )}
          {r.mono && <span class="lg-keys"><code class="lg-code">{r.mono}</code></span>}
        </div>
      ))}
    </div>
  </div>

  <div class="index-aside u-wide mo-g">
    <div id="themes">
      <div class="kc-col-h">Themes</div>
      <p class="sec-p" style="margin-top:4px; font-size:14px">Six presets. Any color can be changed.</p>
      <div class="theme-grid">
        {presets.map((p) => (
          <div class="theme-chip" style={`background:${p.bg.canvas}; color:${p.fg.default}`}>
            <div class="tchip-line"><span style={`color:${p.syntax.comment}`}># {p.name}</span></div>
            <div class="tchip-line"><span style={`color:${p.syntax.keyword}`}>theme</span> = <span style={`color:${p.syntax.string}`}>"{p.polarity}"</span><span class="tchip-caret" style={`background:${p.accent.default}`}></span></div>
          </div>
        ))}
      </div>
    </div>
    <div class="kc-cols" id="shortcuts">
      {kcCols.map((col) => (
        <div class="kc-col">
          <div class="kc-col-h">{col.h}</div>
          {col.rows.map((row) => (
            <div class="kc-row">
              <span class="kc-label">{row.label}</span>
              <span class="kc-keys">
                {row.groups.map((g, gi) => (
                  <Fragment>
                    {gi > 0 && <span class="kc-sep">/</span>}
                    {g.map((k) => <kbd class="kc">{k}</kbd>)}
                  </Fragment>
                ))}
              </span>
            </div>
          ))}
        </div>
      ))}
      <p class="sec-note">Every shortcut can be rebound. The full list is in the <a href={`${base}/docs/#shortcuts`}>docs</a>.</p>
    </div>
  </div>
</section>

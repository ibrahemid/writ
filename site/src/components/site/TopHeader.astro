---
interface Props { onDark?: boolean }
const { onDark = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ibrahemid/writ';
---
<header class:list={['v2-header', 'page', { 'on-dark': onDark }]} data-theme={onDark ? 'dark' : undefined}>
  <div class="hdr-inner">
    <a href={`${base}/`} class="hdr-logo">Writ<span style="color:var(--accent)">.</span></a>
    <nav class="hdr-nav" aria-label="Site">
      <a href={`${base}/docs/`}>Docs</a>
      <a href={`${base}/guides/`}>Guides</a>
      <a href={`${base}/vs/obsidian/`}>Compare</a>
      <a href={`${base}/changelog/`}>Changelog</a>
    </nav>
    <div class="hdr-right">
      <a href={repo} class="hdr-gh hide-sm" rel="noopener noreferrer" target="_blank">GitHub</a>
      <button class="theme-toggle" type="button" data-toggle-theme aria-label="Switch color theme">
        <svg class="ic ic-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="ic ic-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <a href={`${base}/download/`} class="hide-sm hdr-dl">Download</a>
    </div>
  </div>
</header>

<script>
  (function () {
    const root = document.documentElement;
    const toggle = document.querySelector('[data-toggle-theme]');
    const header = document.querySelector<HTMLElement>('.v2-header.on-dark');
    // The header is dark while it sits over the hero band; once the band has
    // scrolled past it takes the page's own theme.
    const band = document.querySelector<HTMLElement>('.hero-band');
    if (header && band && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          const e = entries[0];
          if (!e) return;
          const over = e.isIntersecting;
          header.classList.toggle('on-dark', over);
          if (over) header.setAttribute('data-theme', 'dark');
          else header.removeAttribute('data-theme');
        },
        { rootMargin: '-56px 0px 0px 0px', threshold: 0 },
      );
      io.observe(band);
    }

    function syncTheme() {
      const t = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      if (toggle) {
        toggle.setAttribute('aria-label', t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
      }
    }
    if (toggle) {
      toggle.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('writ:theme', next); } catch (_) {}
        syncTheme();
        document.dispatchEvent(new CustomEvent('writ:theme', { detail: { theme: next } }));
      });
    }
    syncTheme();
  })();
</script>

---
import Section from './Section.astro';
---
<Section slug="find" id="search">
  <h2 class="sec-h2">One search over commands, settings, files, and text.</h2>
  <p class="sec-p">
    <kbd class="kc">⌘</kbd><kbd class="kc">⇧</kbd><kbd class="kc">F</kbd> reaches every
    buffer, open or from history. With a folder open it adds workspace file names and file
    contents, grepped live on each keystroke, so results are never stale.
  </p>
  <div class="prefix-row" role="list" aria-label="Search prefixes">
    <span class="prefix" role="listitem"><code>&gt;</code> commands</span>
    <span class="prefix" role="listitem"><code>#</code> content</span>
    <span class="prefix" role="listitem"><code>:</code> line</span>
  </div>
  <button class="gtrig gtrig-sm" type="button" data-cmd="searchAll" data-arg="settle">
    Search the window for &ldquo;settle&rdquo; →
  </button>
</Section>

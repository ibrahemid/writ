---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Capture from './Capture.astro';

interface Props {
  name: string;
  alt: string;
  poster: string;
  width: number;
  height: number;
  class?: string;
  preload?: 'none' | 'metadata';
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto';
}
const { name, alt, poster, width, height, class: cls = '', preload = 'none', sizes, loading, fetchpriority } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The clip files live in public/ and are not committed, so the build has to
// look for them on disk: import.meta.glob only sees src/. A format ships only
// when both polarities exist, because the client script swaps -light for -dark
// on the theme in use — one without the other is a 404 in one theme.
const mediaDir = fileURLToPath(new URL('../../../public/media/', import.meta.url));
const formats = (['webm', 'mp4'] as const).filter(
  (ext) => existsSync(`${mediaDir}${name}-light.${ext}`) && existsSync(`${mediaDir}${name}-dark.${ext}`),
);

// Capture renders its own placeholder when a still is missing, so the poster
// carries the slot on its own. With neither a clip nor a still there is nothing
// to show and the slot does not render at all.
const posterStills = import.meta.glob('/src/assets/captures/*.{png,webp,jpg}', { eager: true });
const hasPoster = Object.keys(posterStills).some((p) => p.includes(`/${poster}-light.`) || p.includes(`/${poster}-dark.`));
const hasClip = formats.length > 0;
---
{(hasClip || hasPoster) && (
  <div class:list={['shot', 'loop', cls]} data-loop={hasClip ? name : undefined} style={`aspect-ratio:${width}/${height}`}>
    {hasClip && (
      <video muted playsinline loop preload={preload} width={width} height={height} aria-label={alt} data-loop-video>
        {formats.map((ext) => (
          <source data-src={`${base}/media/${name}-light.${ext}`} type={`video/${ext}`} />
        ))}
      </video>
    )}
    <div class="loop-fallback"><Capture name={poster} alt={alt} sizes={sizes} loading={loading} fetchpriority={fetchpriority} /></div>
  </div>
)}

<style is:global>
  .loop { position: relative; }
  .loop video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .loop .loop-fallback { position: absolute; inset: 0; }
  .loop .loop-fallback .shot { height: 100%; border: 0; border-radius: 0; box-shadow: none; }
  .loop .loop-fallback img { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .loop video { opacity: 0; }
  .loop[data-video-playing] video { opacity: 1; }
  .loop[data-video-playing] .loop-fallback { display: none; }
</style>

---
import Capture from './Capture.astro';

interface Props {
  alt: string;
}

const { alt } = Astro.props;

// The frame the hero capture was taken at. The app runs at this size and is
// scaled to the column, so the page at rest shows the same pixels as the still.
const FRAME_WIDTH = 1440;
const FRAME_HEIGHT = 900;
---
<div class="live-window" data-live-window data-frame-width={FRAME_WIDTH} data-frame-height={FRAME_HEIGHT}>
  <div class="live-camera" data-live-camera>
    <Capture name="hero-window" alt={alt} loading="eager" fetchpriority="high" />
  </div>
</div>

<script>
  import { isFrameMessage, readFrameMessage, startTour, type Tour } from '../scripts/tour';

  const host = document.querySelector<HTMLElement>('[data-live-window]');
  const bp = getComputedStyle(document.documentElement).getPropertyValue('--writ-site-bp-lg').trim();
  const wideQuery = bp ? window.matchMedia(`(min-width: ${bp})`) : null;
  const tour: Tour | null =
    host && bp
      ? startTour(host, bp, {
          doc: document,
          matchMedia: (query) => window.matchMedia(query),
          IntersectionObserver,
          ResizeObserver,
          getComputedStyle: (element) => getComputedStyle(element),
          viewport: window,
        })
      : null;

  function mountFrame(root: HTMLElement): void {
    if (root.querySelector('iframe')) return;
    const camera = root.querySelector<HTMLElement>('[data-live-camera]') ?? root;
    const width = Number(root.dataset.frameWidth);
    const height = Number(root.dataset.frameHeight);
    const frame = document.createElement('iframe');
    frame.src = '/demo/';
    frame.title = 'Writ, running in this page';
    frame.width = String(width);
    frame.height = String(height);
    frame.className = 'live-frame';
    frame.setAttribute('loading', 'eager');
    const fitFrame = () => {
      frame.style.transform = `scale(${root.clientWidth / width})`;
    };
    fitFrame();
    new ResizeObserver(fitFrame).observe(root);
    window.addEventListener('message', (event) => {
      if (!isFrameMessage(event, frame.contentWindow, location.origin)) return;
      const message = readFrameMessage(event.data);
      if (!message) return;
      if (message.type === 'writ-demo-ready') {
        root.classList.add('is-live');
        root.querySelector('.window')?.setAttribute('aria-hidden', 'true');
        tour?.connectFrame((name) => frame.contentWindow?.postMessage({ type: 'writ-demo-scene', name }, location.origin));
      } else if (message.type === 'writ-demo-engaged') {
        tour?.markEngaged();
      } else {
        root.dataset.scene = `${message.name}:${message.state}`;
      }
    });
    camera.append(frame);
  }

  if (host && wideQuery) {
    const mountWhenWide = () => {
      if (wideQuery.matches) mountFrame(host);
    };
    const runWhenIdle = (fn: () => void): void => {
      if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(fn, { timeout: 2000 });
      else window.setTimeout(fn, 200);
    };
    if (document.readyState === 'complete') runWhenIdle(mountWhenWide);
    else window.addEventListener('load', () => runWhenIdle(mountWhenWide), { once: true });
    wideQuery.addEventListener('change', mountWhenWide);
  }
</script>

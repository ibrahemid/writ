---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** File stem under public/media, without the `-light.mp4` / `-light.webm` suffix. */
  name: string;
  /** File stem under src/assets/captures, without the `-light.png` suffix. */
  poster: string;
  alt: string;
  class?: string;
}

const { name, poster, alt, class: cls = 'window' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = import.meta.glob<ImageMetadata>('/src/assets/captures/*-light.png', { eager: true, import: 'default' });
const src = Object.entries(all).find(([p]) => p.endsWith(`/${poster}-light.png`))?.[1];
const still = src ? await getImage({ src, format: 'webp', width: 1320 }) : undefined;
---
{still ? (
  <figure class={cls}>
    <video muted loop playsinline preload="none" poster={still.src} aria-label={alt} tabindex="0" data-loop>
      <source src={`${base}/media/${name}-light.webm`} type="video/webm" />
      <source src={`${base}/media/${name}-light.mp4`} type="video/mp4" />
      <p>{alt}</p>
    </video>
  </figure>
) : (
  <figure class:list={[cls, 'owed']} role="img" aria-label={alt} data-capture={poster}></figure>
)}

<script>
  import { startLoopPlayback } from '../scripts/loops';

  startLoopPlayback({
    videos: Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-loop]')),
    reducedQuery: window.matchMedia('(prefers-reduced-motion: reduce)'),
    IntersectionObserver,
    getComputedStyle: (element) => window.getComputedStyle(element),
  });
</script>

{
    "name": "writ",
    "private": true,
    "version": "0.4.0",
    "description": "Light text editor for any text file, with full-text search and inline Markdown",
    "license": "MIT",
    "packageManager": "pnpm@10.13.1",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ibrahemid/writ.git"
    },
    "homepage": "https://github.com/ibrahemid/writ",
    "bugs": "https://github.com/ibrahemid/writ/issues",
    "type": "module",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26",
        "pnpm": ">=9"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "tauri": "tauri",
        "test": "vitest run",
        "tokens:build": "node scripts/tokens-build.mjs",
        "build:demo": "vite build --config vite.demo.config.ts",
        "icons:build": "node scripts/build-icon-sprite.mjs",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.0",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-php": "^6.0.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/language": "^6.12.4",
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.4",
        "@codemirror/view": "^6.43.11",
        "@lezer/highlight": "^1.2.3",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
        "@tauri-apps/plugin-dialog": "^2.7.3",
        "@tauri-apps/plugin-global-shortcut": "^2.3.2",
        "solid-js": "^1.9.15"
    },
    "devDependencies": {
        "@phosphor-icons/core": "^2.1.1",
        "@solidjs/testing-library": "^0.8.10",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.5.1",
        "jsdom": "^30.0.1",
        "style-dictionary": "^5.5.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^4.1.11"
    }
}
